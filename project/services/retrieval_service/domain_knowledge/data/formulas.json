  "formulas": [
    {
      "formula_id": "fourier_law_conduction",
      "name_zh": "傅里叶导热定律",
      "name_en": "Fourier's law of heat conduction",
      "category": "heat_transfer",
      "expression": "q_x = -k * dT/dx; Q_dot = -k * A * dT/dx",
      "latex": "\\dot Q = -k A \\frac{dT}{dx}",
      "variables": [
        {"symbol": "q_x", "name_zh": "热流密度", "unit": "W/m2", "description_zh": "沿 x 方向单位面积导热速率"},
        {"symbol": "Q_dot", "name_zh": "导热热流率", "unit": "W", "description_zh": "通过面积 A 的总导热速率"},
        {"symbol": "k", "name_zh": "导热系数", "unit": "W/(m*K)", "description_zh": "材料导热能力"},
        {"symbol": "A", "name_zh": "传热面积", "unit": "m2"},
        {"symbol": "dT/dx", "name_zh": "温度梯度", "unit": "K/m"}
      ],
      "physical_meaning_zh": "导热热流率与导热系数、传热面积和温度梯度成正比，方向由高温指向低温。",
      "assumptions_zh": ["连续介质", "局部热平衡", "导热系数在使用区间内可视为已知"],
      "applicability_zh": ["固体导热", "静止流体中的导热近似", "平壁、圆筒壁等稳态导热模型的基础"],
      "limitations_zh": ["不直接描述对流换热", "多维或瞬态问题需要更完整的热传导方程", "k 随温度变化明显时应分段或积分处理"],
      "keywords": ["fourier", "傅里叶", "导热定律", "heat conduction", "dT/dx"],
      "aliases": ["傅里叶导热", "Fourier law", "Fourier's law", "导热基本定律"],
      "tool_id": null,
      "examples_zh": ["解释 Q_dot = -k A dT/dx 中各参数的意义。"],
      "engineering_notes_zh": ["平壁一维稳态导热可由该定律积分得到 Q_dot = k A (T1 - T2) / L。"],
      "criteria_zh": [],
      "provenance": {
        "status": "pending",
        "source_id": "source_required_foundational_heat_transfer_textbook",
        "source_type": "textbook_or_handbook_required",
        "note": "公式为基础传热学常识；本地尚未绑定可审计教材/手册页码，不能用无关液冷资料替代来源。"
      }
    },
    {
      "formula_id": "plane_wall_conduction",
      "name_zh": "一维平壁稳态导热量",
      "name_en": "One-dimensional steady plane-wall conduction",
      "category": "heat_transfer",
      "expression": "Q_dot = k * A * (T1 - T2) / L",
      "latex": "\\dot Q = k A \\frac{T_1 - T_2}{L}",
      "variables": [
        {"symbol": "Q_dot", "name_zh": "导热量/热流率", "unit": "W"},
        {"symbol": "k", "name_zh": "导热系数", "unit": "W/(m*K)"},
        {"symbol": "A", "name_zh": "垂直热流方向面积", "unit": "m2"},
        {"symbol": "T1 - T2", "name_zh": "两侧温差", "unit": "K"},
        {"symbol": "L", "name_zh": "平壁厚度", "unit": "m"}
      ],
      "physical_meaning_zh": "平壁稳态导热量随温差、面积、导热系数增大而增大，随厚度增大而减小。",
      "assumptions_zh": ["一维稳态", "无内热源", "材料均匀", "两侧表面温度已知"],
      "applicability_zh": ["平板材料导热估算", "TIM 或壁面层的早期热阻/热流估算"],
      "limitations_zh": ["不能自动代表冷板内部对流", "接触热阻需另建模", "边缘效应显著时不适用"],
      "keywords": ["plane wall", "平壁", "稳态导热", "导热量", "heat rate"],
      "aliases": ["平板导热", "平壁传热", "one dimensional conduction"],
      "tool_id": "plane_wall_conduction",
      "examples_zh": ["厚度 0.05 m、k=0.8 W/(m*K)、面积 2 m2、温差 60 K 时计算导热量。"],
      "engineering_notes_zh": ["该公式与 R_cond = L/(kA) 等价，可写成 Q_dot = ΔT/R_cond。"],
