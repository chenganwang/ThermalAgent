# Local portfolio configuration. Copy this file to project/.env.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=33317
MYSQL_DB=thermal_demo
MYSQL_USER=thermal_demo
MYSQL_PASSWORD=replace-with-local-database-password
# Only used by the optional dedicated MySQL container.
MYSQL_ROOT_PASSWORD=replace-with-a-separate-local-root-password
INDEX_DIR=./indexes
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
# Short sections in examples/cooling-notes.md. Tune these for a larger corpus.
CHUNK_TEXT_CHARS=180
CHUNK_TEXT_HARD_MAX_CHARS=260
CHUNK_TEXT_OVERLAP=12
CHUNK_TEXT_MIN_EMIT_CHARS=65
QC_MERGE_BELOW_CHARS=70
CHUNK_SEMANTIC_ENABLE=false
AGENT_ENABLE_LLM=false
AGENT_MEMORY_BACKEND=local
AGENT_MEMORY_PATH=./runtime/memory
RAG_CORS_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
RAG_API_KEY=
MODEL_GATEWAY_PROVIDER=ollama
MODEL_GATEWAY_BASE_URL=http://127.0.0.1:11434
MODEL_GATEWAY_API_KEY=
# OCR and external simulation tools are optional.
TESS_LANG=chi_sim+eng
